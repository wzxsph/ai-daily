{
  "version": "1.0",
  "ai": {
    "provider": "minimax",
    "model": "MiniMax-M3",
    "base_url": "https://api.minimaxi.com/anthropic",
    "api_key_env": "MINIMAX_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 0.0,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "codex",
        "enabled": true,
        "category": "agent-dev-tools"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "claude-code",
        "enabled": true,
        "category": "agent-dev-tools"
      },
      {
        "type": "repo_releases",
        "owner": "google-gemini",
        "repo": "gemini-cli",
        "enabled": true,
        "category": "agent-dev-tools"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "category": "agent-dev-tools"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "agent-dev-tools"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "category": "agent-dev-tools"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-agents-python",
        "enabled": true,
        "category": "agent-dev-tools"
      },
      {
        "type": "repo_releases",
        "owner": "langchain-ai",
        "repo": "langgraph",
        "enabled": true,
        "category": "agent-dev-tools"
      },
      {
        "type": "repo_releases",
        "owner": "microsoft",
        "repo": "autogen",
        "enabled": true,
        "category": "agent-dev-tools"
      },
      {
        "type": "repo_releases",
        "owner": "modelcontextprotocol",
        "repo": "python-sdk",
        "enabled": true,
        "category": "agent-dev-tools"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 40,
      "min_score": 120,
      "category": "agent-dev-tools"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "models-products",
        "max_items": 10
      },
      {
        "name": "Google DeepMind",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "models-products",
        "max_items": 10
      },
      {
        "name": "Google AI",
        "url": "https://blog.google/technology/ai/rss/",
        "enabled": true,
        "category": "models-products",
        "max_items": 10
      },
      {
        "name": "Hugging Face",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "models-products",
        "max_items": 10
      },
      {
        "name": "GitHub AI & ML",
        "url": "https://github.blog/ai-and-ml/feed/",
        "enabled": true,
        "category": "agent-dev-tools",
        "max_items": 10
      },
      {
        "name": "NVIDIA Developer",
        "url": "https://developer.nvidia.com/blog/feed/",
        "enabled": true,
        "category": "agent-dev-tools",
        "max_items": 10
      },
      {
        "name": "TechCrunch AI",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "enabled": true,
        "category": "industry-policy",
        "max_items": 10
      },
      {
        "name": "The Decoder",
        "url": "https://the-decoder.com/feed/",
        "enabled": true,
        "category": "industry-policy",
        "max_items": 10
      },
      {
        "name": "VentureBeat AI",
        "url": "https://venturebeat.com/category/ai/feed/",
        "enabled": true,
        "category": "industry-policy",
        "max_items": 10
      },
      {
        "name": "量子位",
        "url": "https://www.qbitai.com/feed",
        "enabled": true,
        "category": "industry-policy",
        "max_items": 10
      },
      {
        "name": "arXiv cs.AI",
        "url": "https://rss.arxiv.org/rss/cs.AI",
        "enabled": true,
        "category": "research-papers",
        "max_items": 5
      },
      {
        "name": "arXiv cs.CL",
        "url": "https://rss.arxiv.org/rss/cs.CL",
        "enabled": true,
        "category": "research-papers",
        "max_items": 5
      },
      {
        "name": "arXiv cs.LG",
        "url": "https://rss.arxiv.org/rss/cs.LG",
        "enabled": true,
        "category": "research-papers",
        "max_items": 5
      },
      {
        "name": "GitHub Trending RSS",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "max_items": 30
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 40,
          "category": "research-papers"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 40,
          "category": "models-products"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": []
    },
    "openbb": {
      "enabled": false,
      "watchlists": []
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "ai",
        "agent",
        "llm",
        "machine learning",
        "model",
        "inference",
        "transformer"
      ],
      "min_stars": 5,
      "max_items": 30,
      "category": "github-trending"
    },
    "gdelt": {
      "enabled": false
    },
    "google_news": {
      "enabled": false
    }
  },
  "filtering": {
    "ai_score_threshold": 7.5,
    "time_window_hours": 24,
    "max_items": 15,
    "category_groups": {
      "models_products": {
        "name": "模型与产品",
        "limit": 4,
        "categories": [
          "models-products"
        ]
      },
      "agents_tools": {
        "name": "Agent 与开发工具",
        "limit": 4,
        "categories": [
          "agent-dev-tools"
        ]
      },
      "github_trends": {
        "name": "GitHub 趋势",
        "limit": 3,
        "categories": [
          "github-trending"
        ]
      },
      "research": {
        "name": "论文与研究",
        "limit": 2,
        "categories": [
          "research-papers"
        ]
      },
      "industry_policy": {
        "name": "产业与政策",
        "limit": 2,
        "categories": [
          "industry-policy"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": false
  }
}
